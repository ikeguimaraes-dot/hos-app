{
  "expo": {
    "name": "HOS",
    "slug": "hos-kph",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kph.hos"
    },
    "android": {
      "package": "com.kph.hos",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C4622D"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "O HOS App usa a câmera para gravar vídeos de entrevista e tirar selfie no registro de ponto."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O HOS App usa sua localização para registrar o ponto de trabalho."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O HOS App usa a câmera para tirar a selfie no registro de ponto."
        }
      ],
      "expo-font"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2025d843-bc23-4383-844b-6c073086d5af"
    },
    "extra": {
      "eas": {
        "projectId": "2025d843-bc23-4383-844b-6c073086d5af"
      }
    },
    "owner": "ikeguimaraes"
  }
}