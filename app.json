{
  "expo": {
    "name": "HOS",
    "slug": "hos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366F1"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366F1"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O HOS App usa sua localização para registrar o ponto de trabalho."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O HOS App usa a câmera para tirar a selfie no registro de ponto."
        }
      ]
    ]
  }
}
